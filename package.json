{
  "name": "portfolioos",
  "version": "0.1.0",
  "description": "Local-first, privacy-preserving desktop application for personal finance management and FIRE analysis",
  "main": ".vite/build/main.js",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "author": "PortfolioOS Contributors",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint electron/ src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "dead-code": "knip"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "better-sqlite3": "^11.7.0",
    "duckdb": "^1.1.0",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "uuid": "^11.1.0",
    "zustand": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "duckdb",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "@xmldom/xmldom@>=0.8.0 <0.8.15": "0.8.15",
      "brace-expansion@>=1.0.0 <1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "fast-uri@>=3.0.0 <3.1.7": "3.1.7",
      "ip-address@>=10.0.0 <10.3.1": "10.3.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash@>=4.0.0 <4.18.0": "4.18.0",
      "minimatch@>=3.0.0 <3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@>=8.0.0 <8.5.18": "8.5.18",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "serialize-javascript@<=7.0.2": "7.0.3",
      "smol-toml@>=1.0.0 <1.7.1": "1.7.1",
      "tar@<=7.5.20": "7.5.21",
      "tinypool@<=2.1.1": "2.1.2",
      "tmp@<0.2.6": "0.2.6"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^33.3.0",
    "knip": "^5.83.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.6"
  }
}
