{
  "name": "portfolioos",
  "version": "0.1.0",
  "description": "Local-first, privacy-preserving desktop application for personal finance management and FIRE analysis",
  "main": ".vite/build/main.cjs",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "author": "PortfolioOS Contributors",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint electron/ src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "dead-code": "knip",
    "verify:desktop": "node scripts/verify-desktop.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "better-sqlite3": "^13.1.1",
    "duckdb": "^1.1.0",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "zustand": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "duckdb",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "@tootallnate/once@>=2.0.0 <2.0.1": "2.0.1",
      "@xmldom/xmldom@>=0.8.0 <0.8.15": "0.8.15",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "ip-address@>=10.0.0 <10.7.4": "10.7.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash@>=4.0.0 <4.18.0": "4.18.0",
      "minimatch@>=3.0.0 <3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "node-abi@^3": "3.101.0",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "serialize-javascript@<7.1.3": "7.1.3",
      "smol-toml@>=1.0.0 <1.9.0": "1.9.0",
      "tar@<=7.5.20": "7.5.21",
      "tinypool@<=2.1.1": "2.1.2",
      "tmp@<0.2.7": "0.2.7"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.1",
    "knip": "^6.45.1",
    "playwright": "1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
